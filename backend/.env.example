# ─────────────────────────────────────────────────────────────
# FAILSAFE Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git (it contains secrets).
# ─────────────────────────────────────────────────────────────

# Database connection
DATABASE_URL=postgresql://failsafe_user:failsafe_pass@localhost:5432/failsafe_db

# JWT Secret Key — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ML artifact paths (relative to backend/ directory)
MODEL_PATH=../ml/models/xgboost_model.pkl
PREPROCESSOR_PATH=../ml/models/preprocessor.pkl

# App settings
DEBUG=True
